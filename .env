# CloudTAK - Portainer + Tailscale deployment on t630
#
# This repository is PUBLIC. The four values set to CHANGE_ME are secrets:
# never commit real values. In Portainer (Stacks > Add stack > Repository),
# open Environment variables > Advanced mode, paste this whole file, and
# replace each CHANGE_ME with the real value there. Pasting the whole file
# is required: when Portainer passes its own env file, docker compose does
# not also read this .env from the repository.
#
# Public URL (tailnet only): https://cloudtak.ilish-ide.ts.net
# The tailscale sidecar joins the tailnet as its own node "cloudtak", so no
# host ports on t630 (Frigate 5000/8554, NPM 443, Portainer 9443) are needed.

# ---------------------------------------------------------------- Secrets
# JWT signing key for all CloudTAK tokens. The upstream default
# (coe-wildland-fire) is public and MUST NOT be used.
SigningSecret=CHANGE_ME
# MinIO root password; also used as CloudTAK's S3 secret key
MINIO_ROOT_PASSWORD=CHANGE_ME
# PostGIS password; the POSTGRES connection URL is built from it.
# Hex/alphanumeric only (it is embedded in a URL without escaping).
# Only applied when the postgis volume is first initialised.
POSTGRES_PASSWORD=CHANGE_ME
# Tailscale auth key (admin console > Settings > Keys). Reusable not needed;
# only used on first start because node state is persisted in a volume.
TS_AUTHKEY=CHANGE_ME

# ---------------------------------------------------------------- Mode
CLOUDTAK_Mode=docker-compose
CLOUDTAK_Server_Mode=both

# ---------------------------------------------------------------- URLs
# Browser-facing URLs (served by the tailscale sidecar with a MagicDNS cert)
API_URL=https://cloudtak.ilish-ide.ts.net
PMTILES_URL=https://cloudtak.ilish-ide.ts.net:8443
MEDIA_EXTERNAL_URL=https://cloudtak.ilish-ide.ts.net
# Container-network URLs used for service-to-service calls
API_URL_INTERNAL=http://api:5000
PMTILES_INTERNAL_URL=http://tiles:5002
CLOUDTAK_Config_media_url=http://media

# ---------------------------------------------------------------- Tailscale
TS_HOSTNAME=cloudtak
TS_VERSION=stable
TS_EXTRA_ARGS=

# ---------------------------------------------------------------- Storage
ASSET_BUCKET=cloudtak
AWS_REGION=us-east-1
AWS_S3_Endpoint=http://store:9000
MINIO_ROOT_USER=cloudtak
# AWS_S3_AccessKeyId / AWS_S3_SecretAccessKey default to the MinIO root credentials
# Named Docker volumes (or absolute host paths)
STORE_VOLUME=cloudtak-store
POSTGIS_VOLUME=cloudtak-postgis

# ---------------------------------------------------------------- Database
POSTGRES_DB=gis
POSTGRES_USER=cloudtak

# ---------------------------------------------------------------- Host ports
# Loopback-only; remote access goes through the tailscale sidecar.
# Ports chosen to avoid Frigate (5000, 8554, 8555, 1984), go2rtc (11984,
# 18554), NPM (80, 81, 443) and Portainer (8000, 9000, 9443).
CLOUDTAK_BIND=127.0.0.1
CLOUDTAK_PORT=5080
TILES_PORT=5082
MEDIA_BIND=127.0.0.1
MEDIA_PORT_API=19997
MEDIA_PORT_RTSP=28554
MEDIA_PORT_RTMP=21935
MEDIA_PORT_HLS=28888
MEDIA_PORT_SRT=28890
POSTGRES_PORT=5433
MINIO_PORT_API=9010
MINIO_PORT_CONSOLE=9012

# ---------------------------------------------------------------- Misc
HUB_RPC_PORT=5002
CLOUDTAK_Hub_URL=
MEDIAMTX_LOGLEVEL=info
RETENTION_SCHEDULE=0 3 * * *
